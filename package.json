{
  "name": "bunavat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "client": "npm run dev --workspace client",
    "server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "node --test tests/*.test.js",
    "setup-admin": "npm run setup-admin --workspace server",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
