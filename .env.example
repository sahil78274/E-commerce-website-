# These variables must be exported in your shell or supplied by your process manager.
# The application does not automatically load .env files.
PORT=3001
DB_PATH=data/bunavat.sqlite
NODE_ENV=production
# Only required for the one-time owner creation command. Do not commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Image storage defaults to local persistent storage. Set IMAGE_STORAGE=s3 for S3-compatible storage.
IMAGE_STORAGE=local
UPLOAD_DIR=data/uploads
# For IMAGE_STORAGE=s3 set bucket and region, plus AWS credentials via the AWS SDK credential chain.
S3_BUCKET=
AWS_REGION=
# Optional S3-compatible endpoint (path-style requests). Leave unset for AWS S3.
S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
